# ---------- Server ----------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---------- PostgreSQL (required) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resumely
DB_USER=resumely_user
DB_PASSWORD=
DATABASE_SSL=false

# ---------- Auth (required) ----------
# Generate with: node --input-type=module -e "import {randomBytes} from 'crypto'; console.log(randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Google Gemini (required for resume analysis) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------- Cloudinary (optional: stores the uploaded resume file) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=